    {
        "id": "b014ef38d8f85001",
        "type": "function",
        "z": "d511ed243f196bad",
        "name": "Persist Pet Sighting",
        "func": "const pet = msg.payload.pet;\n\nif (pet !== \"dog\" && pet !== \"cat\") {\n    return null;\n}\n\nconst now = Date.now();\nconst lastWrite = context.get(\"lastWrite\") || 0;\n\n// Only save about once every 10 seconds\nif (now - lastWrite < 10000) {\n    return null;\n}\n\ncontext.set(\"lastWrite\", now);\n\nmsg.params = {\n    $pet: pet,\n    $confidence: msg.payload.confidence,\n    $last_seen: new Date(now).toISOString()\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
