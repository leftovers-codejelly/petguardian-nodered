        "id": "feaf34cbce5f1ca2",
        "type": "function",
        "z": "71a45e6f0d8ad017",
        "name": "Buffer BLE JSON",
        "func": "let buffer = context.get(\"buffer\") || \"\";\n\nbuffer += msg.payload.toString();\n\nlet lines = buffer.split(/\\r?\\n/);\n\n// Keep any incomplete final line for the next chunk\ncontext.set(\"buffer\", lines.pop());\n\nlet messages = [];\n\nfor (let line of lines) {\n    line = line.trim();\n\n    if (line.length > 0) {\n        messages.push({\n            payload: line\n        });\n    }\n}\n\nreturn [messages];",
