        "func": "let lastSeen = flow.get(\"lastSeen\");\n\nif (msg.payload.pet === \"dog\" || msg.payload.pet === \"cat\") {\n    lastSeen = new Date().toLocaleTimeString(\"en-US\", {\n        hour: \"numeric\",\n        minute: \"2-digit\",\n        second: \"2-digit\"\n    });\n\n    flow.set(\"lastSeen\", lastSeen);\n}\n\nmsg.payload = lastSeen || \"No pet detected yet\";\n\nreturn msg;",
